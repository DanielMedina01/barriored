{
  "name": "barriored",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test --config playwright.production.config.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.html docs README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html docs README.md",
    "cap:sync": "npm run build && cap sync && node scripts/native-post-sync.mjs",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/react": "^9.0.6",
    "ionicons": "^8.0.13",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "5.0.3"
  }
}
